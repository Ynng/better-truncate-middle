{
  "name": "better-truncate-middle",
  "version": "0.1.1",
  "description": "Middle-ellipsis polyfill that measures rendered text and keeps the original string in the DOM for find, copy, and accessibility.",
  "license": "MIT",
  "author": "ynng",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ynng/better-truncate-middle.git"
  },
  "homepage": "https://better-truncate-middle.vercel.app",
  "bugs": {
    "url": "https://github.com/ynng/better-truncate-middle/issues"
  },
  "keywords": [
    "polyfill",
    "middle-truncate",
    "ellipsis",
    "text-overflow",
    "pretext",
    "text-measurement"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./polyfill": {
      "types": "./dist/polyfill.d.ts",
      "default": "./dist/polyfill.js"
    },
    "./polyfill.global.js": "./dist/polyfill.global.js",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/polyfill.js",
    "./dist/polyfill.global.js"
  ],
  "scripts": {
    "build": "tsup",
    "check": "biome check && tsc --noEmit && vitest run",
    "e2e": "playwright test",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepublishOnly": "npm run check && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web": "node web/server.mjs --host 0.0.0.0 --port 6008",
    "web:build": "vite build web --outDir ../web-dist --emptyOutDir && vite build web --ssr entry-server.tsx --outDir ../web-dist/server && node scripts/prerender-web.mjs",
    "web:e2e": "node web/server.mjs --host 127.0.0.1 --port 6106"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.6"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shiki": "^4.0.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
